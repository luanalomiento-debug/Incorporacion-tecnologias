# Copiá este archivo como .env.local y completá los valores.
# Los encontrás en Supabase: Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Análisis con IA (solo en el servidor) ---
# IMPORTANTE: estas dos claves son SECRETAS. Nunca llevan el prefijo NEXT_PUBLIC_,
# nunca se suben a GitHub y nunca se comparten. Se cargan solo en Vercel y en .env.local.
# Clave de Anthropic (consola de Anthropic → API keys):
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# Clave secreta de Supabase (Project Settings → API Keys → Secret keys):
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Limpieza diaria automática (solo en el servidor) ---
# Una contraseña larga y aleatoria que inventás vos (por ejemplo, 32 caracteres). Vercel la usa para
# llamar a /api/limpieza todos los días; sin ella la limpieza no se ejecuta.
CRON_SECRET=una-clave-larga-y-aleatoria
